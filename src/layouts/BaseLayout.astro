---
interface Props {
  title: string;
  description?: string;
}
const { title, description = '雪泉 SNOWSPRING — 源自海拔 6000 米雪山的高天然矿泉水（品牌演示站）' } = Astro.props;
const nav = [
  { href: '/', label: '首页' },
  { href: '/tasting/', label: '品鉴雪泉' },
  { href: '/news/', label: '新闻资讯' },
  { href: '/order/', label: '我要订水' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 雪泉 SNOWSPRING</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <header class="site-header" id="site-header">
      <div class="header-inner">
        <a class="brand" href="/">
          <span class="brand-mark">雪泉</span>
          <span class="brand-en">SNOWSPRING</span>
        </a>
        <button class="nav-toggle" id="nav-toggle" aria-label="菜单" aria-expanded="false">☰</button>
        <nav class="site-nav" id="site-nav" aria-label="主导航">
          {nav.map((item) => (
            <a href={item.href} aria-current={current === item.href.replace(/\/$/, '') ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <a class="header-cta" href="/order/">我要订水</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <p class="footer-logo">雪泉 <span>SNOWSPRING</span></p>
          <p class="footer-note">演示站点 · 品牌与内容均为设计示范，不代表任何真实企业</p>
        </div>
        <nav class="footer-nav" aria-label="页脚导航">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="footer-contact">
          <p class="footer-heading">联系我们</p>
          <p>品牌合作：hello@snowspring.example</p>
          <p>订水热线：400-000-0000（演示）</p>
        </div>
      </div>
      <p class="footer-copy">© {new Date().getFullYear()} SNOWSPRING DEMO · 本站为前端设计演示，不含真实交易</p>
    </footer>

    <script>
      const toggle = document.getElementById('nav-toggle');
      const nav = document.getElementById('site-nav');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        toggle?.setAttribute('aria-expanded', String(Boolean(open)));
      });
      const header = document.getElementById('site-header');
      const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 40);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #16232e;
    --snow: #f7f9fb;
    --ice: #e8eef3;
    --mist: #9db1bf;
    --deep: #0d1720;
    --glacier: #2e6f8e;
    --glacier-deep: #1d4e66;
    --line: rgba(22, 35, 46, 0.12);
    --radius: 18px;
    --shadow: 0 18px 50px rgba(13, 23, 32, 0.10);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans SC', sans-serif;
    color: var(--ink);
    background: var(--snow);
    -webkit-font-smoothing: antialiased;
  }
  img { max-width: 100%; display: block; }
  a { color: inherit; }
  .container { width: min(1180px, calc(100% - 48px)); margin-inline: auto; }

  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    background: transparent; transition: background 0.3s ease, box-shadow 0.3s ease;
  }
  .site-header.scrolled, .site-header.solid {
    background: rgba(247, 249, 251, 0.92);
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }
  .header-inner {
    width: min(1280px, calc(100% - 48px)); margin-inline: auto;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    min-height: 72px;
  }
  .brand { display: flex; flex-direction: column; line-height: 1.1; text-decoration: none; }
  .brand-mark { font-size: 22px; font-weight: 700; letter-spacing: 0.35em; }
  .brand-en { font-size: 10px; letter-spacing: 0.42em; color: var(--glacier); font-weight: 600; }
  .site-nav { display: flex; gap: clamp(16px, 2.4vw, 34px); }
  .site-nav a { font-size: 15px; text-decoration: none; color: var(--ink); opacity: 0.82; }
  .site-nav a:hover, .site-nav a[aria-current='page'] { opacity: 1; color: var(--glacier-deep); }
  .header-cta {
    display: inline-block; padding: 10px 22px; border-radius: 999px;
    background: var(--glacier); color: #fff; text-decoration: none; font-size: 14px;
    transition: background 0.2s ease;
  }
  .header-cta:hover { background: var(--glacier-deep); }
  .nav-toggle { display: none; background: none; border: 0; font-size: 22px; cursor: pointer; color: inherit; }

  .site-footer { background: var(--deep); color: rgba(255,255,255,0.82); }
  .footer-inner {
    width: min(1280px, calc(100% - 48px)); margin-inline: auto;
    display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 40px;
    padding: 56px 0 40px;
  }
  .footer-logo { font-size: 20px; font-weight: 700; letter-spacing: 0.3em; margin: 0 0 10px; }
  .footer-logo span { display: block; font-size: 10px; letter-spacing: 0.4em; color: var(--mist); margin-top: 4px; }
  .footer-note { font-size: 13px; color: rgba(255,255,255,0.5); margin: 0; }
  .footer-nav { display: flex; flex-direction: column; gap: 10px; }
  .footer-nav a { font-size: 14px; color: rgba(255,255,255,0.75); text-decoration: none; }
  .footer-nav a:hover { color: #fff; }
  .footer-heading { font-size: 14px; font-weight: 600; color: #fff; margin: 0 0 10px; }
  .footer-contact p { font-size: 13px; margin: 0 0 8px; color: rgba(255,255,255,0.66); }
  .footer-copy {
    width: min(1280px, calc(100% - 48px)); margin-inline: auto;
    padding: 18px 0 26px; border-top: 1px solid rgba(255,255,255,0.12);
    font-size: 12px; color: rgba(255,255,255,0.45); text-align: center; margin-block-start: 0;
  }

  @media (max-width: 860px) {
    .nav-toggle { display: block; }
    .site-nav {
      display: none; position: absolute; top: 100%; left: 0; right: 0;
      flex-direction: column; align-items: flex-start; gap: 4px;
      padding: 12px 24px 20px; background: var(--snow);
      border-bottom: 1px solid var(--line);
    }
    .site-nav.open { display: flex; }
    .header-cta { display: none; }
    .footer-inner { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
