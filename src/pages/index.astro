---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="首页">
  <!-- 主视觉 -->
  <section class="hero">
    <img class="hero-img" src="/images/hero-mountain.webp" alt="雪山主视觉" />
    <div class="hero-shade"></div>
    <div class="hero-copy container">
      <p class="hero-eyebrow">海拔 6000 米 · 昆仑山玉珠峰</p>
      <h1>一滴雪泉<br />来自离天空最近的地方</h1>
      <p class="hero-lead">千年冰川雪被之下，自然滤出一泓清冽。雪泉，只做自然本来的样子。</p>
      <div class="hero-actions">
        <a class="btn btn-light" href="/order/">立即订水</a>
        <a class="btn btn-ghost" href="/tasting/">品鉴雪泉</a>
      </div>
    </div>
    <div class="hero-scroll">向下滚动，开始溯源之旅<span class="scroll-line"></span></div>
  </section>

  <!-- 溯源叙事：三段横向卡片 -->
  <section class="section journey">
    <div class="container">
      <p class="eyebrow">溯源之旅</p>
      <h2 class="h2">一滴雪泉的诞生</h2>
      <p class="lead">从雪山之巅到你的手中，自然完成了绝大部分工作。我们只是守护这个过程。</p>
      <div class="journey-grid">
        <figure class="journey-card reveal">
          <img src="/images/snow-macro.webp" alt="高山雪晶" loading="lazy" />
          <figcaption>
            <span class="step">01</span>
            <h3>千年积雪</h3>
            <p>海拔 6000 米的冰雪，在低温与洁净空气中，历经数十年的自然演化与矿化。</p>
          </figcaption>
        </figure>
        <figure class="journey-card reveal">
          <img src="/images/source-spring.webp" alt="冰川泉眼" loading="lazy" />
          <figcaption>
            <span class="step">02</span>
            <h3>天然过滤</h3>
            <p>融雪顺岩层缓慢下渗，天然过滤与矿化赋予水中均衡的矿物元素与清冽口感。</p>
          </figcaption>
        </figure>
        <figure class="journey-card reveal">
          <img src="/images/mountain-lake.webp" alt="高原冰湖" loading="lazy" />
          <figcaption>
            <span class="step">03</span>
            <h3>源头灌装</h3>
            <p>在水源地原地灌装，从源头到瓶身，不经过长途运输与二次污染。</p>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 水质数据带 -->
  <section class="section data-band">
    <div class="container data-grid">
      <div class="data-item"><strong>6000m</strong><span>雪山海拔</span></div>
      <div class="data-item"><strong>50年+</strong><span>自然滤程</span></div>
      <div class="data-item"><strong> pH 7.8</strong><span>天然弱碱性</span></div>
      <div class="data-item"><strong>0 添加</strong><span>不经任何人工处理</span></div>
    </div>
  </section>

  <!-- 产品 -->
  <section class="section product">
    <div class="container product-grid">
      <div class="product-media reveal">
        <img src="/images/bottle-product.webp" alt="雪泉瓶装水" loading="lazy" />
      </div>
      <div class="product-copy">
        <p class="eyebrow">品鉴雪泉</p>
        <h2 class="h2">清冽，是它的语言</h2>
        <p class="lead">
          入口柔和，落喉清冽，回甘干净。低矿化度的天然弱碱水质，适配日常饮用与佐餐；
          简约瓶身设计，让自然本身成为唯一的装饰。
        </p>
        <ul class="tasting-list">
          <li><span>口感</span>清冽甘润，无异味杂味</li>
          <li><span>矿物</span>天然均衡，低钠低矿化度</li>
          <li><span>适用</span>日常饮用 · 佐餐 · 茶与咖啡冲饮</li>
        </ul>
        <a class="btn btn-primary" href="/tasting/">了解水质详情</a>
      </div>
    </div>
  </section>

  <!-- 水注特写横幅 -->
  <section class="pour-banner">
    <img src="/images/water-pour.webp" alt="倒水特写" loading="lazy" />
    <p class="pour-quote">「水至淡，方知其味。」</p>
  </section>

  <!-- 新闻 -->
  <section class="section news">
    <div class="container">
      <div class="news-head">
        <div>
          <p class="eyebrow">新闻资讯</p>
          <h2 class="h2">雪泉动态</h2>
        </div>
        <a class="text-link" href="/news/">全部资讯 →</a>
      </div>
      <div class="news-grid">
        <a class="news-card" href="/news/">
          <p class="news-date">2026-10-18</p>
          <h3>雪泉水源地获评省级水源保护示范区</h3>
          <p>水源地生态保护与可持续取水管理再上新台阶。</p>
        </a>
        <a class="news-card" href="/news/">
          <p class="news-date">2026-09-30</p>
          <h3>全新「雪屿」玻璃瓶系列上市</h3>
          <p>为高端餐饮场景打造的可回收玻璃瓶装线正式发布。</p>
        </a>
        <a class="news-card" href="/news/">
          <p class="news-date">2026-09-02</p>
          <h3>雪泉携手城市马拉松，为三万名跑者补水</h3>
          <p>全程补给站自然水源直供，践行低碳赛事理念。</p>
        </a>
      </div>
    </div>
  </section>

  <!-- 订水 CTA -->
  <section class="section order-cta">
    <div class="container cta-inner">
      <div>
        <h2 class="h2">把雪山，带回家</h2>
        <p class="lead">家庭订阅 · 企业用水 · 餐饮合作，多种方式享受雪山之味。</p>
      </div>
      <a class="btn btn-primary" href="/order/">立即订水</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* 主视觉 */
  .hero { position: relative; min-height: 92vh; display: flex; align-items: center; overflow: hidden; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(100deg, rgba(9,20,28,0.72) 8%, rgba(9,20,28,0.28) 58%, rgba(9,20,28,0.12) 100%); }
  .hero-copy { position: relative; z-index: 1; color: #fff; }
  .hero-eyebrow { font-size: 13px; letter-spacing: 0.5em; margin: 0 0 18px; color: rgba(255,255,255,0.85); }
  .hero h1 { font-size: clamp(34px, 5.2vw, 62px); line-height: 1.18; margin: 0 0 20px; font-weight: 600; }
  .hero-lead { font-size: 17px; line-height: 1.9; color: rgba(255,255,255,0.88); max-width: 560px; margin: 0 0 32px; }
  .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; }
  .hero-scroll {
    position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
    color: rgba(255,255,255,0.75); font-size: 12px; letter-spacing: 0.2em;
    display: flex; flex-direction: column; align-items: center; gap: 12px;
  }
  .scroll-line { width: 1px; height: 44px; background: linear-gradient(to bottom, rgba(255,255,255,0.8), transparent); animation: drip 2.2s ease infinite; }
  @keyframes drip { 0% { transform: scaleY(0); transform-origin: top; } 55% { transform: scaleY(1); } 100% { opacity: 0; } }

  .btn { display: inline-block; padding: 13px 34px; border-radius: 999px; font-size: 15px; text-decoration: none; transition: all 0.2s ease; }
  .btn-light { background: #fff; color: var(--deep); }
  .btn-light:hover { background: var(--ice); }
  .btn-ghost { border: 1px solid rgba(255,255,255,0.65); color: #fff; }
  .btn-ghost:hover { background: rgba(255,255,255,0.12); }
  .btn-primary { background: var(--glacier); color: #fff; }
  .btn-primary:hover { background: var(--glacier-deep); }

  .section { padding: clamp(72px, 9vw, 120px) 0; }
  .eyebrow { font-size: 13px; letter-spacing: 0.45em; color: var(--glacier); margin: 0 0 14px; }
  .h2 { font-size: clamp(26px, 3.4vw, 40px); font-weight: 600; letter-spacing: 0.06em; margin: 0 0 16px; }
  .lead { font-size: 16px; line-height: 2; color: var(--muted, #5b6b77); margin: 0 0 28px; max-width: 620px; }

  .journey-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; margin-top: 40px; }
  .journey-card { margin: 0; background: #fff; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
  .journey-card img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 0.5s ease; }
  .journey-card:hover img { transform: scale(1.04); }
  .journey-card figcaption { padding: 22px 24px 26px; }
  .step { font-size: 12px; letter-spacing: 0.3em; color: var(--glacier); font-weight: 600; }
  .journey-card h3 { margin: 8px 0 10px; font-size: 19px; }
  .journey-card p { margin: 0; font-size: 14px; line-height: 1.9; color: #5b6b77; }

  .data-band { background: var(--deep); padding: clamp(48px, 6vw, 72px) 0; }
  .data-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .data-item { display: flex; flex-direction: column; gap: 6px; text-align: center; color: #fff; }
  .data-item strong { font-size: clamp(26px, 3vw, 38px); font-weight: 600; letter-spacing: 0.04em; }
  .data-item span { font-size: 13px; color: var(--mist); letter-spacing: 0.15em; }

  .product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .product-media img { border-radius: var(--radius); box-shadow: var(--shadow); }
  .tasting-list { list-style: none; margin: 0 0 32px; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .tasting-list li { display: flex; gap: 18px; font-size: 15px; color: #33424d; }
  .tasting-list span { flex: none; width: 52px; color: var(--glacier); font-weight: 600; }

  .pour-banner { position: relative; }
  .pour-banner img { width: 100%; max-height: 62vh; object-fit: cover; }
  .pour-quote {
    position: absolute; inset: auto 0 48px; text-align: center;
    color: #fff; font-size: clamp(18px, 2.4vw, 26px); letter-spacing: 0.3em;
    text-shadow: 0 2px 24px rgba(0,0,0,0.45); margin: 0;
  }

  .news-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; }
  .text-link { font-size: 14px; color: var(--glacier); text-decoration: none; }
  .news-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; margin-top: 36px; }
  .news-card { background: #fff; border-radius: var(--radius); padding: 26px 26px 30px; text-decoration: none; box-shadow: var(--shadow); transition: transform 0.3s ease; display: flex; flex-direction: column; gap: 10px; }
  .news-card:hover { transform: translateY(-6px); }
  .news-date { font-size: 12px; color: var(--glacier); letter-spacing: 0.15em; margin: 0; }
  .news-card h3 { margin: 0; font-size: 17px; line-height: 1.6; }
  .news-card p:last-child { margin: 0; font-size: 14px; color: #5b6b77; line-height: 1.8; }

  .order-cta { background: linear-gradient(135deg, var(--deep), #14344a); color: #fff; }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .cta-inner .lead { color: rgba(255,255,255,0.8); margin: 0; }
  .order-cta .btn-primary { background: #fff; color: var(--deep); }

  .reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.7s ease, transform 0.7s ease; }
  .reveal.visible { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    .journey-grid, .news-grid, .product-grid { grid-template-columns: 1fr; }
    .data-grid { grid-template-columns: repeat(2, 1fr); gap: 36px 16px; }
    .hero { min-height: 78vh; }
  }
</style>

<script>
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
  }, { threshold: 0.14 });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
